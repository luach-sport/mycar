{
  "appId": "com.luachsport.mycar",
  "appName": "MyCar",
  "webDir": "www",
  "backgroundColor": "#F3F6FC",
  "android": {
    "backgroundColor": "#F3F6FC",
    "allowMixedContent": false
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_mycar",
      "iconColor": "#1652F0"
    },
    "StatusBar": {
      "backgroundColor": "#F3F6FC",
      "style": "LIGHT",
      "overlaysWebView": false
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": "",
      "updateUrl": "",
      "channelUrl": "",
      "allowModifyUrl": false,
      "appReadyTimeout": 15000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true,
      "shakeMenu": false,
      "disableJSLogging": true
    }
  }
}
